  "tutorialTitle": "How Relay works",
  "@tutorialTitle": {},
  "tutorialOfferTitle": "Want the idea behind Relay first?",
  "@tutorialOfferTitle": {},
  "tutorialOfferBody": "Relay works differently from the feeds you know. Five short steps and it clicks — or jump straight in and pick it up as you go.",
  "@tutorialOfferBody": {},
  "tutorialOfferAccept": "Show me the idea behind Relay",
  "@tutorialOfferAccept": {},
  "tutorialOfferDecline": "I’ll explore it on my own",
