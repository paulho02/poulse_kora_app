worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm
               image/svg+xml font/woff2;
    gzip_min_length 1024;

    server {
        # Railway injects PORT at runtime; docker-entrypoint.sh substitutes it
        # in before nginx starts.
        listen ${PORT};
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        # Flutter web is a single-page app: unknown paths (client-side routes
        # from go_router) must fall back to index.html rather than 404.
        location / {
            try_files $uri $uri/ /index.html;
        }

        # Flutter's own bootstrap files keep a fixed name across builds (unlike
        # a bundler's content-hashed chunks), so an immutable long cache here
        # would mean a browser that's ever loaded the app never picks up a new
        # deploy. Must revalidate on every request, same as index.html.
        location ~* ^/(main\.dart\.js|flutter(_bootstrap|_service_worker)?\.js|version\.json|manifest\.json)$ {
            add_header Cache-Control "no-cache";
        }

        # Everything else in the build output (assets/, canvaskit/, fonts) is
        # genuinely content-addressed, so it's safe to long-cache.
        location ~* \.(?:js|css|wasm|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        location = /index.html {
            add_header Cache-Control "no-cache";
        }
    }
}
